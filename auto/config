#!/bin/sh
# live-build configuration for the DaygleVE appliance ISO.
#
# `lb config` reads this via `auto/config`. Values here define a Debian live
# image that boots straight into the DaygleVE stack. Keep the suite/arch in
# sync with versions.env.
set -e

# Single source of truth for the pinned suite/arch/version. When invoked via
# build.sh these are already exported; sourcing versions.env here keeps a bare
# `lb config` correct too, so this file can't drift from the pins.
CONFIG_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
if [ -f "$CONFIG_ROOT/versions.env" ]; then
  # shellcheck disable=SC1091
  . "$CONFIG_ROOT/versions.env"
fi

: "${DEBIAN_SUITE:=trixie}"
: "${ARCH:=amd64}"

# Force Debian mode with explicit Debian mirrors. Without this, live-build on
# an Ubuntu host (e.g. the GitHub runner) auto-detects "ubuntu" mode and tries
# to fetch the Debian suite (trixie) from Ubuntu mirrors, which fails with
# "Failed getting release file .../ubuntu/dists/trixie/Release".
lb config noauto \
  --mode debian \
  --distribution "${DEBIAN_SUITE}" \
  --architectures "${ARCH}" \
  --archive-areas "main contrib non-free-firmware" \
  --mirror-bootstrap "http://deb.debian.org/debian/" \
  --mirror-chroot "http://deb.debian.org/debian/" \
  --mirror-chroot-security "http://security.debian.org/debian-security/" \
  --mirror-binary "http://deb.debian.org/debian/" \
  --mirror-binary-security "http://security.debian.org/debian-security/" \
  --debian-installer none \
  --firmware-chroot true \
  --memtest none \
  --iso-application "DaygleVE" \
  --iso-publisher "DaygleVE" \
  --iso-volume "DaygleVE ${DAYGLEVE_VERSION:-dev}" \
  --bootappend-live "boot=live components quiet splash" \
  "${@}"
