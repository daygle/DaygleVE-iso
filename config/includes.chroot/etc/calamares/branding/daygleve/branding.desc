---
# DaygleVE branding for the Calamares installer.
#
# calamares-settings-debian ships a "debian" branding component and points
# /etc/calamares/settings.conf at it. The chroot hook repoints that to this
# component (branding: daygleve), so the installer shows DaygleVE's name,
# logo and colors instead of Debian's.
componentName: daygleve

# Use the traditional "Welcome to the %1 installer." heading (DaygleVE in
# place of %1) instead of the Calamares-branded wording.
welcomeStyleCalamares: false

# Center the window; let Calamares pick a sensible default size.
welcomeExpandingLogo: true
windowExpanding: normal
windowPlacement: center

# Layout of the installer chrome (explicit values silence "setting is missing"
# warnings and keep the classic left sidebar + bottom nav buttons).
sidebar: widget
navigation: widget

# The slideshow shown in the installer panel while packages are copied.
# Calamares treats a missing `slideshow` key as a FATAL error and refuses to
# start (a black screen at boot), so this key is required. slideshowAPI: 2 is
# the modern QML Presentation interface used by show.qml.
slideshow: "show.qml"
slideshowAPI: 2

strings:
    productName:         "DaygleVE"
    shortProductName:    "DaygleVE"
    version:             "1.0.0"
    shortVersion:        "1.0"
    versionedName:       "DaygleVE 1.0.0"
    shortVersionedName:  "DaygleVE 1.0"
    bootloaderEntryName:  "DaygleVE"
    productUrl:          "https://github.com/daygle"
    supportUrl:          "https://github.com/daygle/DaygleVE-backend/issues"
    knownIssuesUrl:      "https://github.com/daygle/DaygleVE-backend/issues"
    releaseNotesUrl:     "https://github.com/daygle"

images:
    # A transparent, colorful mark so it reads on either a light or dark
    # welcome page; the product name is drawn by Calamares from the strings
    # above, so the logo intentionally carries no wordmark.
    productLogo:         "mark.svg"
    productIcon:         "icon.svg"

# DaygleVE palette (matches the logomark / web UI).
style:
    SidebarBackground:       "#0f172a"
    SidebarText:              "#e6edf3"
    SidebarBackgroundCurrent: "#22d3ee"
    SidebarTextCurrent:       "#0f172a"
