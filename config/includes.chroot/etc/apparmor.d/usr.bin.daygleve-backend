#include <tunables/global>

# AppArmor policy for the unprivileged DaygleVE API. Privileged host tools,
# devices, sysfs writes, and mount operations belong exclusively to the
# root-owned daygleve-broker profile.
/usr/bin/daygleve-backend flags=(attach_disconnected) {
  #include <abstractions/base>
  #include <abstractions/nameservice>
  #include <abstractions/ssl_certs>

  network unix stream,
  network inet stream,
  network inet6 stream,

  /usr/bin/daygleve-backend mr,

  /var/lib/daygleve/ rw,
  /var/lib/daygleve/** rwk,
  /usr/share/daygleve/web/ r,
  /usr/share/daygleve/web/** r,
  /etc/daygleve/daygleve.env r,
  /etc/hosts r,
  /etc/resolv.conf r,
  /etc/ssl/** r,
  /run/daygleve/broker.sock rw,
  /run/systemd/resolve/stub-resolv.conf r,
  /proc/ r,
  /proc/** r,
}
