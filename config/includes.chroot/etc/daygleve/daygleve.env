# Default runtime configuration for the DaygleVE backend on the appliance.
# Read by the daygleve-backend systemd unit (EnvironmentFile).

# Bind the API + web UI on all interfaces, port 8080.
DAYGLEVE_LISTEN=0.0.0.0:8080

# Serve the bundled frontend SPA from here (populated by the ISO build).
DAYGLEVE_WEB_ROOT=/usr/share/daygleve/web

# Persistent control-plane records, including operation history and recovery
# records. Keep this on the installed system disk so it survives reboots.
DAYGLEVE_STATE_DIR=/var/lib/daygleve

# Default ZFS pool for new datasets/volumes.
DAYGLEVE_ZPOOL=tank

# Log level (error|warn|info|debug|trace).
RUST_LOG=info
