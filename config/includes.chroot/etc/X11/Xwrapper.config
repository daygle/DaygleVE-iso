# Permit the auto-logged-in live user to start the X server for the DaygleVE
# installer session via startx. The Debian default (allowed_users=console)
# usually suffices, but some VM/console setups fail the console check; allowing
# any user keeps the installer launch reliable on the live image. This applies
# only to the ephemeral live environment, not the installed system.
allowed_users=anybody
needs_root_rights=yes
