#!/bin/sh
# Runs inside the image chroot during `lb build`: enable the services that
# make the box a DaygleVE node on first boot.
set -e

# The DaygleVE control plane (API + web UI).
systemctl enable daygleve-backend.service
systemctl enable daygleve-live-session.service

# Virtualization / container / storage daemons.
systemctl enable libvirtd.service || true
systemctl enable lxc.service || true
systemctl enable zfs-import-cache.service || true
systemctl enable zfs-mount.service || true
systemctl enable zfs-zed.service || true
systemctl enable ssh.service || true

# Entropy daemon: keep the kernel pool full in the live environment so Calamares
# never blocks generating the machine-id / entropy seed on a low-entropy VM.
systemctl enable haveged.service || true

# Ensure the backend binary is executable (permissions can be lost via
# includes.chroot copying).
if [ -f /usr/bin/daygleve-backend ]; then
  chmod 0755 /usr/bin/daygleve-backend
fi

# sudoers drop-ins must be mode 0440, or sudo refuses to read them.
if [ -f /etc/sudoers.d/daygleve-installer ]; then
  chmod 0440 /etc/sudoers.d/daygleve-installer
fi

# Keep the live-session launcher and xinit script executable after live-build
# copies the files into the live user's home directory.
chmod 0755 /usr/local/sbin/daygleve-live-session /etc/skel/.xinitrc

# Point Calamares at the DaygleVE branding component. calamares-settings-debian
# ships settings.conf with `branding: debian`; repoint it to the DaygleVE
# component installed at /etc/calamares/branding/daygleve so the installer
# shows DaygleVE's name, logo and colors.
if [ -f /etc/calamares/settings.conf ]; then
  if grep -q '^branding:' /etc/calamares/settings.conf; then
    sed -i 's/^branding:.*/branding: daygleve/' /etc/calamares/settings.conf
  else
    echo 'branding: daygleve' >> /etc/calamares/settings.conf
  fi
fi

# Stop Calamares from copying the host entropy pool into the target. On a
# headless/low-entropy VM this "Generate machine-id" / createEntropy step can
# block and freeze the installer partway through. The installed system seeds its
# own entropy on first boot, so skipping the copy is safe. We write our own
# machineid.conf (after packages are installed) so it wins over the one shipped
# by calamares-settings-debian, keeping systemd + dbus machine-id generation but
# disabling the entropy copy.
mkdir -p /etc/calamares/modules
cat > /etc/calamares/modules/machineid.conf <<'EOF'
---
# Generate /etc/machine-id via systemd-machine-id-setup.
systemd: true
# Generate /var/lib/dbus/machine-id and symlink it to /etc/machine-id.
dbus: true
dbus-symlink: true
# Do NOT copy the host entropy seed into the target: this can block the
# installer on a low-entropy VM. The installed system seeds itself on first boot.
entropy-copy: false
entropy: false
EOF

# The live user (created by live-config) runs the graphical installer through
# daygleve-live-session.service on tty1. The default systemd target stays
# multi-user (no display manager); the installed hypervisor is headless, and
# calamares-settings-debian removes calamares/xorg from the target during install.
