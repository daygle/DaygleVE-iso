# Packages installed into the DaygleVE live image (chroot stage).
# One package per line; comments allowed.

# --- Base / boot ---
linux-image-amd64
linux-headers-amd64
systemd-sysv
firmware-linux-free
live-boot
live-config
live-config-systemd

# --- Bootloader support for the live image ---
# The generic and unsigned GRUB packages used by Calamares are also staged in
# the daygleve-bootloader-*.list.binary files so they are available from the
# ISO package pool.
grub-efi-amd64-signed
shim-signed
grub-pc-bin
efibootmgr
os-prober

# --- Virtualization: KVM/QEMU + libvirt ---
qemu-system-x86
qemu-utils
libvirt-daemon-system
libvirt-clients
ovmf

# --- Containers: LXC ---
lxc
lxcfs

# --- Storage: ZFS (built via DKMS against the installed kernel) ---
zfsutils-linux
zfs-dkms
zfs-zed

# --- Networking ---
bridge-utils
iproute2
ifupdown2
vlan

# --- Base utilities / management ---
openssh-server
ca-certificates
curl
gnupg
sudo
chrony
# haveged keeps the kernel entropy pool full in headless VMs so the installer
# never blocks generating machine-id / SSH host keys on a low-entropy system.
haveged

# --- Graphical installer (Calamares) + a minimal X session to display it ---
# The live image boots into a lightweight X session that auto-launches the
# Calamares installer through the live-only daygleve-live-session.service;
# calamares-settings-debian configures it to install the
# live DaygleVE system to disk. `xorg` pulls the X server + all video/input
# drivers so it just works on real hardware and in VMs.
xorg
xinit
openbox
calamares
calamares-settings-debian
# xhost/xsetroot let the session paint the brand background and grant root
# access to the user-owned X server; xterm surfaces the installer log on screen
# if Calamares ever exits non-zero, instead of leaving a black display.
x11-xserver-utils
xterm
