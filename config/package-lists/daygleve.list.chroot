# Packages installed into the DaygleVE live image (chroot stage).
# One package per line; comments allowed.

# --- Base / boot ---
linux-image-amd64
linux-headers-amd64
systemd-sysv
firmware-linux-free
live-boot
live-config
live-config-systemd

# --- Bootloader (baked into the image so the installer needs no network) ---
# Without these, Calamares tries to download grub at install time and fails on
# an offline machine ("Temporary failure resolving deb.debian.org", then
# update-grub not found). Include signed EFI grub + shim for UEFI/Secure Boot
# and grub-pc for legacy BIOS, plus efibootmgr to write EFI boot entries.
grub-efi-amd64-signed
shim-signed
grub-pc-bin
efibootmgr
os-prober

# --- Virtualization: KVM/QEMU + libvirt ---
qemu-system-x86
qemu-utils
libvirt-daemon-system
libvirt-clients
ovmf

# --- Containers: LXC ---
lxc
lxcfs

# --- Storage: ZFS (built via DKMS against the installed kernel) ---
zfsutils-linux
zfs-dkms
zfs-zed

# --- Networking ---
bridge-utils
iproute2
ifupdown2
vlan

# --- Base utilities / management ---
openssh-server
ca-certificates
curl
gnupg
sudo
chrony

# --- Graphical installer (Calamares) + a minimal X session to display it ---
# The live image boots into a lightweight X session that auto-launches the
# Calamares installer through the live-only daygleve-live-session.service;
# calamares-settings-debian configures it to install the
# live DaygleVE system to disk. `xorg` pulls the X server + all video/input
# drivers so it just works on real hardware and in VMs.
xorg
xinit
openbox
calamares
calamares-settings-debian
