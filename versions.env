# Pinned component versions assembled into the DaygleVE ISO.
#
# Bump these together for each release, then run ./build.sh (or trigger the
# build-iso workflow). Each value is an immutable git tag on the respective
# repo, so a given DAYGLEVE_VERSION always assembles the exact same bits.

# The release tag to pull the backend binary and frontend site from.
DAYGLEVE_VERSION="v1.0.0"

# Source repositories (owner/name) for the release artifacts.
BACKEND_REPO="daygle/DaygleVE-backend"
FRONTEND_REPO="daygle/DaygleVE-frontend"

# Debian base for the live image.
DEBIAN_SUITE="trixie"
ARCH="amd64"
